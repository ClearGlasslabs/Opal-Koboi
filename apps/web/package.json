{
  "name": "clearglass-artemis-browser",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "start": "node .next/standalone/server.js",
    "build": "next build && find .next -type f -name '*.map' -delete && mkdir -p .next/standalone/.next && cp -R .next/static .next/standalone/.next/static",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "typescript": "7.0.2",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.4.0"
  }
}
